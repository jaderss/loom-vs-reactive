# Versions, resources and workload for every run. No secrets belong here.
# Override any value per run, for example: make bench APPS=webflux SCENARIOS=statement

JAVA_VERSION=25
GO_VERSION=1.27
POSTGRES_VERSION=18.6
TOXIPROXY_VERSION=2.13.0
NODE_VERSION=26
NGINX_VERSION=1.31

# Same resources for every app. Postgres, Toxiproxy, mock and loadgen get their own CPUs.
APP_CPUS=2
APP_MEMORY_MB=1536
HEAP_PERCENT=75
JVM_GC=ParallelGC
JAVA_OPTS=
POSTGRES_CPUS=2
TOXIPROXY_CPUS=1
LOADGEN_CPUS=2
MOCK_CPUS=1

# Same pool and timeouts in every app.
POOL_SIZE=20
DB_ACQUIRE_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=2000
DB_SOCKET_TIMEOUT_S=5
DOWNSTREAM_TIMEOUT_MS=1000
TOMCAT_MAX_THREADS=200
FANOUT_THREADS=600
LEGACY_LOCK_STRIPES=1024

SEED_ACCOUNTS=100000
SEED_TXN_PER_ACCOUNT=50

APPS=mvc-vt mvc-platform webflux coroutines
SCENARIOS=read statement slow-db overload legacy-lock
LEGACY_LOCK_JAVA_VERSIONS=21 25
USERS=2000
THINK_TIME=1s
DURATION=60s
RAMP_UP=15s
ROUNDS=5
REQUEST_TIMEOUT=10s
SAMPLE_EVERY=100
STATEMENT_LIMIT=20
MOCK_LATENCY=30ms
MOCK_JITTER=10ms
MOCK_RATE=1.0900
MOCK_ERROR_RATE=0
DB_LATENCY_MS=20
ARRIVAL_RATES=1000 2000 4000 8000
